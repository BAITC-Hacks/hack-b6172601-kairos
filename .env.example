# Copy to .env and fill in. Never commit .env.
#
# Both providers issued at the hackathon speak the OpenAI chat-completions API,
# so only these three lines change between them.
#
#   OpenAI:  LLM_PROVIDER=openai   LLM_MODEL=gpt-4.1-mini
#   NVIDIA:  LLM_PROVIDER=nvidia   LLM_MODEL=meta/llama-3.3-70b-instruct
#   Other:   LLM_PROVIDER=custom   LLM_BASE_URL=https://...  LLM_MODEL=...

LLM_PROVIDER=openai
LLM_API_KEY=replace-me
LLM_MODEL=
LLM_BASE_URL=

APP_NAME=kairos
APP_ENV=local
LOG_LEVEL=INFO

# Agent limits. Keep them small: a runaway loop burns the demo.
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=60
AGENT_TEMPERATURE=0.2

# Requests per minute per client IP. 0 disables the limiter.
# Set this to 20 on a public deployment so the issued key cannot be drained.
RATE_LIMIT_PER_MINUTE=0

# Honour X-Forwarded-For when identifying the caller. Enable ONLY behind a
# platform proxy (Render, Fly.io, Railway): on a directly reachable service any
# caller can forge that header and bypass the limiter.
TRUST_PROXY_HEADERS=false

# Header set by the platform's own edge, which a client cannot forge.
# On Fly.io: fly-client-ip. Leave empty when there is no such header.
# Prefer this over TRUST_PROXY_HEADERS: an edge that APPENDS to a
# client-supplied X-Forwarded-For leaves the first entry attacker-controlled.
CLIENT_IP_HEADER=
